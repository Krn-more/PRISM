# Local/deployment secret configuration. Leave values empty in this template.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=

# Optional Stage 5 EPA CTX integration
EPA_CTX_ENABLED=false
EPA_CTX_API_KEY=
# Approved public DTXSID, InChIKey, CAS, or CASRN used only by the manual live check.
EPA_CTX_TEST_IDENTIFIER=

# Optional Stage 7 ClassyFire/ChemOnt hierarchy enrichment. The app sends only
# a resolved public InChIKey, caches the response locally, and continues if unavailable.
CHEMONT_CLASSYFIRE_ENABLED=false

# Optional Toxtree/AMBIT self-hosted integration. Set this to your own AMBIT
# base URL when you run a local or internal server, for example:
# https://your-host/ambit2
TOXTREE_AMBIT_BASE_URL=
# Only needed if your AMBIT instance protects POST operations with HTTP Basic auth.
TOXTREE_BASIC_AUTH_USER=
TOXTREE_BASIC_AUTH_PASS=

# Optional local headless Toxtree runner. Use this if you want real Cramer/TTC
# output without any AMBIT credentials. Point TOXTREE_JAR_PATH at the Toxtree JAR
# and TOXTREE_JAVA_PATH at java.exe if it is not already on PATH.
TOXTREE_EXECUTION_MODE=local
TOXTREE_JAR_PATH=
TOXTREE_JAVA_PATH=

# Optional Stage 6 grounded drafting (false keeps AI reasoning out of local runs)
XAI_ENABLED=false
XAI_STAGE6_ENABLED=false

# Required only when deliberately invoking a diagnostics script.
RUN_LIVE_DIAGNOSTICS=false
