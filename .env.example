# Optional Azure AI configuration. This template intentionally contains no
# credentials. Copy it to .env only when Azure AI cluster reasoning is approved.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_KEY=

# Azure AI cluster reasoning is disabled unless both flags are explicitly true.
XAI_ENABLED=false
XAI_STAGE6_ENABLED=false
